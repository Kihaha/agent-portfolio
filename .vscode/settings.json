{
  // ============ 第 1 件事的核心：让编辑器自动守规矩 ============

  // 1) 保存时自动格式化
  "editor.formatOnSave": true,

  // 2) 指定 Python 的格式化器为 Ruff（不指定的话 VS Code 不知道用谁）
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff"
  },

  // 3) 保存时自动修复 lint 问题
  //    ⚠️ 注意：2026 版的 Ruff 扩展注册的是「通用」code action，
  //    键名**不带** .ruff 后缀；写成 source.fixAll.ruff 会静默失效。
  //    这里故意不写 source.organizeImports，避免与 Pylance 的导入排序
  //    同时执行、每次保存互相改写顺序（import 排序已由下面的 I 规则覆盖）。
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit"
  },
  "ruff.fixAll": true,

  // 4) 让 Ruff 检查的规则范围。
  //    默认只有 E4/E7/E9/F，**不含 import 排序**；加上 I 才能自动整理 import
  "ruff.lint.select": ["E", "F", "I"],

  // 5) 行宽与下面的标尺保持一致
  "ruff.lineLength": 100,

  // ============ Python 解释器与类型检查 ============

  // 优先使用项目里的虚拟环境（必须写绝对路径，相对路径 VS Code 解析不了）
  "python.defaultInterpreterPath": "C:\\Users\\kk\\Desktop\\dsh\\agent-portfolio\\.venv\\Scripts\\python.exe",
  "python.terminal.activateEnvironment": true,

  // 类型检查强度：basic 会主动报出「类型不匹配」，
  // 这是对 Python 基础弱的人最有用的一条——错误在敲代码时就暴露
  "python.analysis.typeCheckingMode": "basic",

  // ============ 让写代码更省心的细节 ============
  "editor.rulers": [100],
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/*.egg-info": true
  }
}
